#!/usr/bin/env bash
# otb - kelola OpenCode Telegram Bot yang terpasang dengan install.sh
set -euo pipefail
umask 022

INSTALL_CONF=/etc/otb/install.conf
WORKSPACE=/srv/workspace

die()  { printf '\033[1;31m[otb] GAGAL:\033[0m %s\n' "$*" >&2; exit 1; }
log()  { printf '\033[1;34m[otb]\033[0m %s\n' "$*" >&2; }

[[ -f "$INSTALL_CONF" ]] || die "otb belum terpasang (tidak ada $INSTALL_CONF). Jalankan install.sh dulu."
MODE="$(sed -n 's/^MODE=//p' "$INSTALL_CONF")"
REPO_DIR="$(sed -n 's/^REPO_DIR=//p' "$INSTALL_CONF")"
COMPOSE=(docker compose -f "$REPO_DIR/docker-compose.yml")
# The installer code is owned by root; without this, git refuses it for other users
# ("dubious ownership"). Read-only use by non-root (otb version) is safe.
repo_git() { git -c safe.directory="$REPO_DIR" -C "$REPO_DIR" "$@"; }

need_root() { [[ $EUID -eq 0 ]] || exec sudo "$0" "$@"; }

usage() {
  cat <<EOF
Pemakaian: otb <perintah>

  status               status layanan dan versi
  logs [bot|agent] [-f] log layanan (default: bot)
  restart              restart bot dan agen
  verify               jalankan uji keamanan
  clone <url> [nama]   clone repo ke $WORKSPACE sebagai user agen
  attach               buka TUI OpenCode yang terhubung ke agen (sesi yang sama dengan Telegram)
  policy [nama]        lihat/ganti persetujuan perintah: otomatis | seimbang | ketat | custom
  github-key [test|off] beri agen akses git push ke GitHub (setiap push tetap ditanya)
  reconfigure          ganti token, user ID, model, atau API key
  update [tag]         perbarui ke rilis terbaru (atau tag tertentu)
  uninstall [--purge]  hapus layanan; --purge juga menghapus konfigurasi dan workspace
  version              versi yang terpasang
EOF
}

cmd_version() {
  local ref="(bukan repo git)"
  repo_git rev-parse --git-dir >/dev/null 2>&1 \
    && ref="$(repo_git describe --tags --always 2>/dev/null)"
  echo "otb $ref (mode $MODE)"
  echo "  opencode-telegram-bot $(sed -n 's/.*"@grinev\/opencode-telegram-bot": "\(.*\)".*/\1/p' "$REPO_DIR/deploy/bot/package.json")"
  echo "  opencode-ai           $(sed -n 's/.*"opencode-ai": "\(.*\)".*/\1/p' "$REPO_DIR/deploy/agent/package.json")"
}

cmd_status() {
  cmd_version
  echo
  local recent
  if [[ "$MODE" == "systemd" ]]; then
    systemctl --no-pager --lines=0 status otb-agent.service otb-bot.service 2>/dev/null | grep -E '●|Active:' || true
    recent="$(journalctl -u otb-bot.service --since '-3 min' --no-pager 2>/dev/null || true)"
  else
    "${COMPOSE[@]}" ps --format 'table {{.Name}}\t{{.Status}}'
    recent="$(docker logs --since 3m otb-bot 2>&1 || true)"
  fi
  if grep -q "409: Conflict" <<<"$recent"; then
    cat <<'EOF'

MASALAH: token bot ini sedang dipakai program lain (Telegram 409 Conflict).
Hanya satu program yang boleh memakai satu token. Kemungkinan pelakunya:
  - opencode-telegram-bot asli yang pernah dijalankan (di VPS ini atau di laptop);
  - instalasi otb lain (mode docker, atau VPS lain) dengan token yang sama.
Cek di VPS ini:  ps aux | grep -E "opencode-telegram|cli.js start" | grep -v grep
Paling pasti: di @BotFather pilih bot Anda -> API Token -> Revoke, lalu
pasang token baru dengan: otb reconfigure
EOF
  fi
}

cmd_logs() {
  local svc="bot" follow=()
  for a in "$@"; do
    case "$a" in
      bot|agent) svc="$a" ;;
      -f|--follow) follow=(-f) ;;
      *) die "Argumen tidak dikenal: $a" ;;
    esac
  done
  if [[ "$MODE" == "systemd" ]]; then
    journalctl -u "otb-$svc.service" -n 100 --no-pager "${follow[@]}"
  else
    docker logs --tail 100 "${follow[@]}" "otb-$svc"
  fi
}

# Wait until the agent answers again after a restart (it takes a few seconds to start).
wait_agent() {
  local pw
  pw="$(sed -n 's/^OPENCODE_SERVER_PASSWORD=//p' /etc/otb/agent.env)"
  for _ in $(seq 1 45); do
    if [[ "$MODE" == "systemd" ]]; then
      printf 'user = "opencode:%s"\n' "$pw" | curl -sf -m 3 --config - http://127.0.0.1:4096/config >/dev/null 2>&1 && return 0
    else
      docker exec otb-bot node -e 'fetch("http://agent:4096/config",{headers:{authorization:"Basic "+Buffer.from("opencode:"+process.env.OPENCODE_SERVER_PASSWORD).toString("base64")}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))' 2>/dev/null && return 0
    fi
    sleep 1
  done
  log "Agen belum merespons setelah 45 detik; cek: otb logs agent"
}

cmd_restart() {
  if [[ "$MODE" == "systemd" ]]; then systemctl restart otb-agent.service otb-bot.service
  else "${COMPOSE[@]}" restart; fi
  wait_agent
  log "Layanan di-restart."
}

# The TUI is only a client: tools still run inside the agent sandbox, not in this terminal.
cmd_attach() {
  local pw
  pw="$(sed -n 's/^OPENCODE_SERVER_PASSWORD=//p' /etc/otb/agent.env)"
  if [[ "$MODE" == "systemd" ]]; then
    local tmp; tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    HOME="$tmp" XDG_CONFIG_HOME="$tmp/c" XDG_DATA_HOME="$tmp/d" XDG_CACHE_HOME="$tmp/cache" \
      OPENCODE_SERVER_PASSWORD="$pw" OPENCODE_DISABLE_DEFAULT_PLUGINS=1 \
      /opt/otb/agent/node_modules/.bin/opencode attach --dir "$WORKSPACE" http://127.0.0.1:4096
  else
    docker exec -it -e OPENCODE_SERVER_PASSWORD="$pw" -e HOME=/tmp/attach otb-agent \
      /opt/otb/agent/node_modules/.bin/opencode attach --dir "$WORKSPACE" http://127.0.0.1:4096
  fi
}

cmd_policy() {
  local conf=/etc/otb/policy.conf custom=/etc/otb/policy-custom.json managed=/etc/opencode/opencode.json
  local current name="${1:-}" src
  current="$(sed -n 's/^POLICY=//p' "$conf" 2>/dev/null)"
  if [[ -z "$name" ]]; then
    echo "Kebijakan aktif: ${current:-tidak diketahui}"
    cat <<EOF

  otomatis  jalan sendiri; hanya yang penting ditanya (hapus file, reset git, jaringan, database, kill)
  seimbang  perintah baca & build/test umum jalan sendiri; lainnya ditanya
  ketat     hampir semua perintah ditanya
  custom    pakai $custom apa adanya (buat dari preset aktif: otb policy custom)

Semua preset tetap memblokir: git push, sudo, ssh/scp, docker, systemctl, crontab, akses di luar proyek.
Ganti dengan: otb policy <nama>
EOF
    return 0
  fi
  case "$name" in
    otomatis|seimbang|ketat)
      src="$REPO_DIR/config/policies/$name.json"
      grep -q '^PUSH=1' "$conf" 2>/dev/null && src="$REPO_DIR/config/policies/$name-push.json" ;;
    custom)
      if [[ ! -f "$custom" ]]; then
        install -m 0644 -o root -g root "$managed" "$custom"
        log "Dibuat $custom dari preset ${current:-aktif}. Edit file itu, lalu jalankan lagi: otb policy custom"
        return 0
      fi
      src="$custom" ;;
    *) die "Kebijakan tidak dikenal: $name (otomatis | seimbang | ketat | custom)" ;;
  esac
  if command -v python3 >/dev/null; then
    python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$src" 2>/dev/null || die "$src bukan JSON yang valid."
  fi
  cat "$src" > "$managed"          # same inode: Docker mode bind-mounts this file
  conf_set "$conf" POLICY "$name"
  if [[ "$MODE" == "systemd" ]]; then systemctl restart otb-agent.service otb-bot.service
  else "${COMPOSE[@]}" restart agent bot >/dev/null; fi
  wait_agent
  log "Kebijakan persetujuan sekarang: $name (berlaku untuk perintah berikutnya)."
}

conf_set() { # conf_set <file> <KEY> <VALUE>  -> world-readable key=value file, other keys kept
  local f="$1" k="$2" v="$3"
  touch "$f"
  { grep -v "^$k=" "$f" || true; printf '%s=%s\n' "$k" "$v"; } > "$f.tmp"
  chmod 0644 "$f.tmp"; mv "$f.tmp" "$f"
}

# GitHub's published SSH host key fingerprints (docs.github.com, "GitHub's SSH key
# fingerprints"). Used only when the host keys cannot be fetched from api.github.com.
GITHUB_FPS="${OTB_GITHUB_FPS:-SHA256:+DiY3wvvV6TuJJhbpZisF/zLDA0zPMSvHdkr4UvCOqU SHA256:p2QAMXNIC1TJYWeIOttrVc98/R1BUFWu3/LiyKgUfQM SHA256:uNiVztksCsDhcc0u9e8BujQXVUpKZIDTMczCvj3tD2s}"
GITHUB_SSH_HOST="${OTB_GITHUB_SSH_HOST:-ssh.github.com}"
GITHUB_SSH_PORT="${OTB_GITHUB_SSH_PORT:-443}"

agent_run() { # agent_run <cmd...>  -> run as the agent user with its HOME
  if [[ "$MODE" == "systemd" ]]; then
    (cd / && runuser -u otb-agent -- env HOME=/var/lib/otb-agent XDG_CONFIG_HOME=/etc/otb/agent-xdg "$@")
  else
    docker exec -i otb-agent "$@"
  fi
}

# Known-hosts lines for GitHub, verified: from the TLS-protected API, otherwise via
# ssh-keyscan keeping only keys whose fingerprint matches GitHub's published ones.
github_known_hosts() {
  local line keys tmp fp ok=""
  keys="$( (curl -fsS -m 15 https://api.github.com/meta 2>/dev/null || true) \
    | sed -n 's/^ *"\(ssh-[a-z0-9-]* [A-Za-z0-9+\/=]*\)",\{0,1\}$/\1/p; s/^ *"\(ecdsa-[a-z0-9-]* [A-Za-z0-9+\/=]*\)",\{0,1\}$/\1/p')"
  if [[ -n "$keys" ]]; then
    while IFS= read -r line; do printf '[%s]:%s %s\n' "$GITHUB_SSH_HOST" "$GITHUB_SSH_PORT" "$line"; done <<<"$keys"
    return 0
  fi
  tmp="$(mktemp)"
  ssh-keyscan -p "$GITHUB_SSH_PORT" -T 10 "$GITHUB_SSH_HOST" 2>/dev/null > "$tmp" || true
  if ! grep -qv '^#' "$tmp"; then
    rm -f "$tmp"; echo "unreachable" >&2; return 1
  fi
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    fp="$(ssh-keygen -lf - <<<"$line" 2>/dev/null | awk '{print $2}')"
    if [[ -n "$fp" && " $GITHUB_FPS " == *" $fp "* ]]; then printf '%s\n' "$line"; ok=1; fi
  done < "$tmp"
  rm -f "$tmp"
  [[ -n "$ok" ]] || { echo "mismatch" >&2; return 1; }
}

# Re-run the installer quietly to apply policy + git config; show its output only on failure.
reapply() {
  local logf rc=0
  logf="$(mktemp)"
  log "Menerapkan konfigurasi (±1 menit)…"
  "$REPO_DIR/install.sh" --mode "$MODE" --non-interactive --skip-telegram-check --no-deps --no-harden-host >"$logf" 2>&1 || rc=$?
  [[ $rc -eq 0 ]] || sed 's/\x1b\[[0-9;]*m//g' "$logf" | tail -n 15 >&2
  rm -f "$logf"
  return $rc
}

cmd_github_key() {
  local conf=/etc/otb/policy.conf home pub kh
  if [[ "${1:-}" == off ]]; then
    conf_set "$conf" PUSH 0
    reapply || die "Gagal menerapkan ulang konfigurasi (log di atas)."
    log "git push dimatikan lagi (diblokir). Hapus juga key-nya di GitHub jika tidak dipakai."
    return 0
  fi
  command -v ssh-keygen >/dev/null || { apt-get install -y -qq openssh-client >/dev/null 2>&1 || die "openssh-client belum terpasang."; }
  if [[ "$MODE" == "systemd" ]]; then home=/var/lib/otb-agent; else home=/home/agent; fi

  # Key comment = this VPS's name, so it is recognisable in GitHub's key list.
  agent_run sh -c 'umask 077; mkdir -p "$HOME/.ssh"; [ -f "$HOME/.ssh/id_ed25519" ] || ssh-keygen -q -t ed25519 -N "" -C "$1" -f "$HOME/.ssh/id_ed25519"' \
    sh "otb-agent@$(hostname)"
  local why
  if ! kh="$(github_known_hosts 2>/tmp/otb-kh.err)"; then
    why="$(cat /tmp/otb-kh.err 2>/dev/null)"; rm -f /tmp/otb-kh.err
    if [[ "$why" == mismatch ]]; then
      die "BAHAYA: host key $GITHUB_SSH_HOST:$GITHUB_SSH_PORT TIDAK cocok dengan fingerprint resmi GitHub. Kemungkinan koneksi disadap; dibatalkan."
    fi
    die "Host key GitHub tidak bisa diambil (api.github.com dan $GITHUB_SSH_HOST:$GITHUB_SSH_PORT tidak terjangkau dari VPS ini)."
  fi
  rm -f /tmp/otb-kh.err
  printf '%s\n' "$kh" | agent_run sh -c 'umask 077; cat > "$HOME/.ssh/known_hosts_github"'
  # Port 443 works where providers block outgoing port 22.
  agent_run sh -c "umask 077; cat > \"\$HOME/.ssh/config\"" <<EOF
Host github.com
  HostName $GITHUB_SSH_HOST
  Port $GITHUB_SSH_PORT
  User git
  IdentityFile $home/.ssh/id_ed25519
  IdentitiesOnly yes
  StrictHostKeyChecking yes
  UserKnownHostsFile $home/.ssh/known_hosts_github
EOF
  pub="$(agent_run cat "$home/.ssh/id_ed25519.pub")"

  conf_set "$conf" PUSH 1
  reapply || die "Gagal menerapkan ulang konfigurasi (log di atas)."

  cat <<EOF

Public key agen (tempel di GitHub):

$pub

Pilih salah satu:
  a) Semua repo:  https://github.com/settings/ssh/new
     PERHATIAN: agen bisa push ke SEMUA repo di akun Anda.
  b) Satu repo saja (lebih aman): Settings repo -> Deploy keys -> Add deploy key,
     centang "Allow write access". Satu key hanya bisa dipakai di satu repo.

Setelah ditempel, uji dengan: otb github-key test
Setiap git push tetap meminta persetujuan di Telegram; force push / hapus branch diblokir.
Pengaman terkuat ada di GitHub: Settings repo -> Rules -> Rulesets -> "Block force pushes"
untuk main (aturan OpenCode berbasis nama perintah bisa diakali lewat skrip).
EOF
}

cmd_github_key_test() {
  local out
  out="$(agent_run ssh -T -o BatchMode=yes -o ConnectTimeout=15 git@github.com 2>&1 || true)"
  if grep -q "successfully authenticated" <<<"$out"; then
    log "Berhasil: $(grep -o 'Hi [^!]*' <<<"$out" | head -1). Agen bisa push."
  else
    printf '%s\n' "$out" >&2
    die "Belum bisa login ke GitHub. Pastikan public key sudah ditempel (otb github-key menampilkannya lagi)."
  fi
}

cmd_clone() {
  local url="${1:-}" name="${2:-}"
  [[ -n "$url" ]] || die "Pemakaian: otb clone <url> [nama-folder]"
  [[ -n "$name" ]] || { name="$(basename "$url")"; name="${name%.git}"; }
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "Nama folder tidak valid: $name"
  umask 0027
  if [[ "$MODE" == "systemd" ]]; then
    runuser -u otb-agent -- env HOME=/var/lib/otb-agent XDG_CONFIG_HOME=/etc/otb/agent-xdg \
      git clone -- "$url" "$WORKSPACE/$name"
  else
    docker exec otb-agent git clone -- "$url" "$WORKSPACE/$name"
  fi
  log "Siap: $WORKSPACE/$name. Pilih proyek ini di Telegram dengan /projects."
}

cmd_update() {
  local target="${1:-}" current
  repo_git rev-parse --git-dir >/dev/null 2>&1 || die "$REPO_DIR bukan repo git; update manual."
  repo_git fetch --tags --force --quiet origin
  [[ -n "$target" ]] || target="$(repo_git tag --list 'v*' --sort=-v:refname | head -n1)"
  if [[ -z "$target" ]]; then
    repo_git fetch --quiet origin main
    target=origin/main
    log "Belum ada rilis bertag; memakai branch main."
  fi
  current="$(repo_git describe --tags --always)"
  if [[ "$(repo_git rev-parse HEAD)" == "$(repo_git rev-parse "$target^{commit}")" ]]; then
    log "Sudah di $target."; return 0
  fi
  echo "Perubahan $current -> $target:"
  repo_git log --oneline "HEAD..$target" | sed 's/^/  /'
  read -r -p "Lanjutkan update? (y/n) [n]: " reply </dev/tty || reply=""
  [[ "$reply" =~ ^[Yy] ]] || { log "Update dibatalkan."; return 0; }
  repo_git -c advice.detachedHead=false checkout --quiet "$target"
  exec "$REPO_DIR/install.sh" --mode "$MODE"
}

cmd_uninstall() {
  local purge=0
  [[ "${1:-}" == "--purge" ]] && purge=1
  cat <<EOF
Yang akan dihapus:
  - layanan otb (mode $MODE) beserta image/volume Docker atau unit systemd
  - /opt/otb/agent, /opt/otb/bot, user otb-agent/otb-bot/otb-build, perintah otb
EOF
  if [[ $purge -eq 1 ]]; then
    echo "  - PERMANEN: /etc/otb (token & API key), /etc/opencode, dan $WORKSPACE (semua proyek!)"
  else
    echo "Yang DIPERTAHANKAN: /etc/otb (konfigurasi) dan $WORKSPACE (proyek). Pakai --purge untuk ikut menghapus."
  fi
  read -r -p "Ketik 'yes' untuk melanjutkan: " reply </dev/tty || reply=""
  [[ "$reply" == "yes" ]] || { log "Dibatalkan."; return 0; }

  if [[ "$MODE" == "systemd" ]]; then
    systemctl disable --now otb-bot.service otb-agent.service 2>/dev/null || true
    rm -f /etc/systemd/system/otb-bot.service /etc/systemd/system/otb-agent.service
    systemctl daemon-reload
  else
    "${COMPOSE[@]}" down --rmi all -v 2>/dev/null || true
  fi
  rm -rf /opt/otb/agent /opt/otb/bot /opt/otb/README.md /var/lib/otb-bot /var/lib/otb-agent
  for u in otb-bot otb-agent otb-build; do id -u "$u" >/dev/null 2>&1 && userdel "$u" 2>/dev/null; done
  rm -f /usr/local/bin/otb "$INSTALL_CONF"
  if [[ $purge -eq 1 ]]; then
    rm -rf /etc/otb /etc/opencode "$WORKSPACE"
    getent group otb-ws >/dev/null && groupdel otb-ws 2>/dev/null
  fi
  log "Uninstall selesai. Kode sumber installer tetap ada di $REPO_DIR."
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  status) cmd_status ;;
  logs) need_root logs "$@"; cmd_logs "$@" ;;
  restart) need_root restart; cmd_restart ;;
  verify) need_root verify; exec "$REPO_DIR/verify.sh" ;;
  clone) need_root clone "$@"; cmd_clone "$@" ;;
  attach) need_root attach; cmd_attach ;;
  github-key)
    need_root github-key "$@"
    case "${1:-}" in test) cmd_github_key_test ;; *) cmd_github_key "$@" ;; esac ;;
  policy) if [[ -n "${1:-}" ]]; then need_root policy "$@"; fi; cmd_policy "$@" ;;
  reconfigure) need_root reconfigure; exec "$REPO_DIR/install.sh" --mode "$MODE" --reconfigure --no-harden-host ;;
  update) need_root update "$@"; cmd_update "$@" ;;
  uninstall) need_root uninstall "$@"; cmd_uninstall "$@" ;;
  version|--version) cmd_version ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
