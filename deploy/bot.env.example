# /etc/aao/bot.env  (root:root 0600; systemd reads it before switching to aao-bot)

# Telegram
TELEGRAM_BOT_TOKEN=GANTI_TOKEN_DARI_BOTFATHER
TELEGRAM_ALLOWED_USER_ID=GANTI_USER_ID_ANDA
BOT_LOCALE=id

# OpenCode V2 (agent service on this machine)
OPENCODE_SERVER_VERSION=v2
OPENCODE_API_URL=http://127.0.0.1:49374
OPENCODE_SERVER_PASSWORD=SAMA_DENGAN_DI_agent.env
OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=big-pickle

# /open only browses the workspace
OPEN_BROWSER_ROOTS=/srv/workspace

# Memory (agent-ai-opencode)
AAO_MCP_PORT=18090
AAO_MCP_TOKEN=SAMA_DENGAN_DI_opencode.json
AAO_SNAPSHOT_PATH=/var/lib/aao-shared/MEMORY.md
# AAO_CAPTURE_DAILY_LIMIT=30
# AAO_DIGEST_HOUR=20
