# /etc/aao/agent.env  (root:root 0600; systemd reads it before switching to aao-agent)

# Fixed password for the OpenCode API (the bot uses the same value).
OPENCODE_SERVER_PASSWORD=GANTI_PASSWORD_ACAK

# Optional: OpenCode Zen API key (https://opencode.ai/auth). Free models work without it.
# OPENCODE_API_KEY=
