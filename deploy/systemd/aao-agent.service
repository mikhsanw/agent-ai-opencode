# OpenCode V2 server (the agent). It runs every shell command the AI issues, so this unit
# is the real security boundary: the agent only sees /srv/workspace and reads the memory
# snapshot; /home, /root, the bot's token and the memory database are hidden from it.
[Unit]
Description=agent-ai-opencode: OpenCode V2 agent (sandboxed)
Documentation=https://github.com/mikhsanw/agent-ai-opencode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aao-agent
Group=aao-agent
EnvironmentFile=/etc/aao/agent.env
Environment=HOME=/var/lib/aao-agent
Environment=XDG_CONFIG_HOME=/etc/aao/opencode
Environment=XDG_DATA_HOME=/var/lib/aao-agent/data
Environment=XDG_STATE_HOME=/var/lib/aao-agent/state
Environment=XDG_CACHE_HOME=/var/lib/aao-agent/cache
WorkingDirectory=/srv/workspace
ExecStart=/opt/aao/opencode/node_modules/.bin/opencode serve --hostname 127.0.0.1 --port 49374
Restart=on-failure
RestartSec=5

# Filesystem: read-only everywhere except the workspace and the agent's own state.
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/workspace /var/lib/aao-agent
ReadOnlyPaths=/var/lib/aao-shared
InaccessiblePaths=-/etc/aao/bot.env -/var/lib/aao-bot
PrivateTmp=yes

# Privileges: no root, no capabilities, no way to regain them.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# Resources: on a shared VPS the agent must be the one that dies on OOM, not other services.
MemoryHigh=600M
MemoryMax=800M
OOMScoreAdjust=500
TasksMax=512
CPUQuota=150%

[Install]
WantedBy=multi-user.target
