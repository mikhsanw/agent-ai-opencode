# /etc/otb/bot.env  (root:root 0600)  -- read by the Telegram bot only.
# The agent cannot read this file, so a hijacked agent cannot steal the bot token.

# From @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (from @userinfobot). Only this account can use the bot.
TELEGRAM_ALLOWED_USER_ID=

# Connection to the sandboxed OpenCode server. Leave as is.
OPENCODE_SERVER_VERSION=v1
OPENCODE_API_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=__GENERATED__
OPENCODE_AUTO_RESTART_ENABLED=false

# Default model, e.g. google + gemini-2.5-pro, anthropic + claude-sonnet-4-5
OPENCODE_MODEL_PROVIDER=
OPENCODE_MODEL_ID=

OPEN_BROWSER_ROOTS=/srv/workspace
BOT_LOCALE=id
