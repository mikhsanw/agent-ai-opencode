# /etc/otb/agent.env  (root:root 0600)  -- read by the OpenCode agent only.
# install.sh fills OPENCODE_SERVER_PASSWORD automatically. Never reuse it elsewhere.

OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=__GENERATED__

# --- LLM provider key: uncomment the ONE you use. Set a spending limit at the provider.
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
