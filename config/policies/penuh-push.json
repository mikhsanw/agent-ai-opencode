{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "allow",
      "*.env.*": "allow",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "question": "allow",
    "task": "allow",
    "skill": "allow",
    "edit": {
      "*": "allow",
      "*.env": "allow",
      "*.env.*": "allow",
      "*opencode.json": "deny",
      "*opencode.jsonc": "deny",
      "*.opencode/*": "deny",
      "*.git/*": "deny",
      "*.gitattributes": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "deny",
    "doom_loop": "ask",
    "bash": {
      "*": "allow",
      "scp *": "deny",
      "crontab *": "deny",
      "git remote add *": "deny",
      "git remote set-url *": "deny",
      "git config *": "deny",
      "sudo *": "deny",
      "su": "deny",
      "su *": "deny",
      "ssh *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "socat *": "deny",
      "systemctl *": "deny",
      "docker *": "deny",
      "chmod *+s*": "deny",
      "git push": "ask",
      "git push *": "ask",
      "*/git push *": "ask",
      "git push -f": "deny",
      "git push -f *": "deny",
      "git push * -f": "deny",
      "git push * -f *": "deny",
      "git push *--force*": "deny",
      "git push *--force-with-lease*": "deny",
      "git push *--mirror*": "deny",
      "git push *--delete*": "deny",
      "git push * -d *": "deny",
      "git push * :*": "deny",
      "git push * +*": "deny",
      "*/git push *--force*": "deny",
      "*/git push * -f*": "deny"
    }
  }
}
