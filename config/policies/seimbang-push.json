{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "question": "allow",
    "task": "allow",
    "skill": "ask",
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*opencode.json": "deny",
      "*opencode.jsonc": "deny",
      "*.opencode/*": "deny",
      "*.git/*": "deny",
      "*.gitattributes": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "diff *": "allow",
      "echo *": "allow",
      "which *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git stash": "allow",
      "git stash *": "allow",
      "git restore --staged *": "allow",
      "git mv *": "allow",
      "git init": "allow",
      "git init *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "bun *": "allow",
      "composer *": "allow",
      "php *": "allow",
      "php artisan *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pip *": "allow",
      "pytest": "allow",
      "pytest *": "allow",
      "go *": "allow",
      "cargo *": "allow",
      "flutter *": "allow",
      "dart *": "allow",
      "make": "allow",
      "make *": "allow",
      "git remote add *": "deny",
      "git remote set-url *": "deny",
      "git config *": "deny",
      "sudo *": "deny",
      "su": "deny",
      "su *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "socat *": "deny",
      "crontab *": "deny",
      "systemctl *": "deny",
      "docker *": "deny",
      "chmod *+s*": "deny",
      "git push": "ask",
      "git push *": "ask",
      "*/git push *": "ask",
      "git push -f": "deny",
      "git push -f *": "deny",
      "git push * -f": "deny",
      "git push * -f *": "deny",
      "git push *--force*": "deny",
      "git push *--force-with-lease*": "deny",
      "git push *--mirror*": "deny",
      "git push *--delete*": "deny",
      "git push * -d *": "deny",
      "git push * :*": "deny",
      "git push * +*": "deny",
      "*/git push *--force*": "deny",
      "*/git push * -f*": "deny"
    }
  }
}
