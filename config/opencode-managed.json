{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "question": "allow",
    "task": "allow",
    "skill": "ask",
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*opencode.json": "deny",
      "*opencode.jsonc": "deny",
      "*.opencode/*": "deny",
      "*.git/*": "deny",
      "*.gitattributes": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git branch": "allow",
      "git diff *--output*": "ask",
      "git diff *--ext-diff*": "ask",
      "git log *--output*": "ask",
      "git push": "deny",
      "git push *": "deny",
      "git remote add *": "deny",
      "git remote set-url *": "deny",
      "git config *": "deny",
      "sudo *": "deny",
      "su": "deny",
      "su *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "socat *": "deny",
      "crontab *": "deny",
      "systemctl *": "deny",
      "docker *": "deny",
      "chmod *+s*": "deny"
    }
  }
}
